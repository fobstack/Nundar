{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kontor",
  // 自定义入口：复用 OpenNext 的 fetch handler，另加 Cron 的 scheduled handler
  "main": "src/worker.ts",
  // 不要超过本地 workerd 二进制支持的最新日期，否则 vitest-pool-workers 起不来
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "observability": {
    "enabled": true
  },

  // 主数据库。
  //
  // database_id 是本地占位值：本地开发与测试走 miniflare 模拟的 D1，不读取它；
  // 用 Deploy to Cloudflare 按钮部署时，Cloudflare 会自动建库并把真实 id 写回这里。
  // 手工部署则跑一次 `wrangler d1 create <name>` 再把 id 填进来。
  //
  // 迁移与灌数据的脚本一律用**绑定名 DB** 而不是库名——别人部署时库名可能不同，
  // 写死库名会让他们的迁移找不到库。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kontor",
      "database_id": "local-placeholder-replace-before-deploy",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  "r2_buckets": [
    // 商品图原图与预生成尺寸变体
    {
      // 不能叫 IMAGES：那是 Cloudflare Images 产品的保留绑定名，
      // 用它会让 wrangler types 生成 ImagesBinding 而非 R2Bucket
      "binding": "MEDIA",
      "bucket_name": "kontor-media"
    },
    // OpenNext 的 ISR 增量缓存
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "kontor-inc-cache"
    }
  ],

  // 游客购物车、后台 session、限流计数
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "local-placeholder-replace-before-deploy"
    }
  ],

  // 事务邮件（订单确认、发货通知）。发件域名需先执行：
  // npx wrangler email sending enable <yourdomain.com>
  "send_email": [{ "name": "EMAIL" }],

  // OpenNext 的重验证队列需要 Worker 自引用
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kontor"
    }
  ],

  // ISR 三件套：队列去重时间型重验证，分片 tag cache 支撑按需 revalidate，
  // BucketCachePurge 负责缓存清除
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
      { "name": "NEXT_CACHE_DO_PURGE", "class_name": "BucketCachePurge" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler",
        "DOShardedTagCache",
        "BucketCachePurge"
      ]
    }
  ],

  // 每日 06:00 UTC 拉取 ECB 汇率并按阈值触发价格重算（handler 在阶段 3 实现）
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
