{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nundar",
  // Custom entry: reuses OpenNext's fetch handler and adds the cron scheduled handler
  "main": "src/worker.ts",
  // Must not exceed the newest date the local workerd binary supports, or
  // vitest-pool-workers refuses to start
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "observability": {
    "enabled": true
  },

  // The primary database.
  //
  // database_id is a local placeholder: development and tests run against
  // miniflare's simulated D1 and never read it. Deploying with the Deploy to
  // Cloudflare button provisions the database and writes the real id back here.
  // Deploying by hand means running `wrangler d1 create <name>` and pasting the
  // returned id in.
  //
  // Migration and seed scripts always reference the **binding** DB, never the
  // database name: someone else's deployment may name the database differently,
  // and a hardcoded name would send their migrations looking for a database
  // that does not exist.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nundar",
      "database_id": "local-placeholder-replace-before-deploy",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  "r2_buckets": [
    // Product originals and their pre-generated size variants
    {
      // Must not be called IMAGES: that name is reserved by Cloudflare Images,
      // and using it makes `wrangler types` emit ImagesBinding instead of R2Bucket
      "binding": "MEDIA",
      "bucket_name": "nundar-media"
    },
    // OpenNext's incremental (ISR) cache
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "nundar-inc-cache"
    }
  ],

  // Guest carts, admin sessions, rate-limit counters
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "local-placeholder-replace-before-deploy"
    }
  ],

  // Transactional email (order confirmation, shipping notice). The sending
  // domain must be enabled first:
  // npx wrangler email sending enable <yourdomain.com>
  "send_email": [{ "name": "EMAIL" }],

  // OpenNext's revalidation queue requires the Worker to reference itself
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nundar"
    }
  ],

  // The ISR trio: the queue deduplicates time-based revalidation, the sharded
  // tag cache backs on-demand revalidation, and BucketCachePurge does the purging
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
      { "name": "NEXT_CACHE_DO_PURGE", "class_name": "BucketCachePurge" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler",
        "DOShardedTagCache",
        "BucketCachePurge"
      ]
    }
  ],

  // Daily at 06:00 UTC: pull ECB rates and recompute prices whose drift passed
  // the threshold
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
