{%- comment -%}
  The header, in two tiers: the site's name with the languages and the cart
  on the sheet, and the sections on a graphite band below. The band
  scrolls sideways inside itself on a narrow screen, so it needs no menu
  button and no script.
{%- endcomment -%}
<header class="top">
  <div class="shell top-bar">
    <a class="brand" href="{{ site.home_path }}">{{ site.name }}</a>
    {% if site.tagline != "" %}<p class="brand-line">{{ site.tagline }}</p>{% endif %}
    <div class="top-tools">
      {% if page.alternates.size > 1 %}
      <ul aria-label="{{ t.language }}">
        {% for alt in page.alternates %}<li><a href="{{ alt.href }}" hreflang="{{ alt.locale }}" lang="{{ alt.locale }}"{% if alt.locale == site.locale %} aria-current="true"{% endif %}>{{ alt.name }}</a></li>{% endfor %}
      </ul>
      {% endif %}
      {% assign cart_path = plugins.shop.cart_path %}
      {% if cart_path == blank %}{% assign cart_path = plugin_page.cart_path %}{% endif %}
      {% if cart_path != blank %}<a class="top-cart" href="{{ cart_path }}"{% if plugin_page.cart_path != blank %} aria-current="page"{% endif %}>{{ t.cart }}</a>{% endif %}
    </div>
  </div>
  {% if site.nav.size > 0 %}
  <nav class="top-nav" aria-label="{{ t.nav }}">
    <ul class="shell">
      {% for item in site.nav %}<li><a href="{{ item.href }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a></li>{% endfor %}
    </ul>
  </nav>
  {% endif %}
</header>
