{%- comment -%}
  Products as a ruled table: the name, the sizes, and — when the shop says
  anything of a product — the lowest price it can be ordered at and whether
  it can be had. The plugin is told which products a list or the home page
  shows, and not which a content page lists, so under a collection the same
  table has names and no prices.
  Called as {% render "partials/catalogue", items: list.items %}.
{%- endcomment -%}
<table class="ledger stack" role="table">
  <thead role="rowgroup">
    <tr role="row"><th scope="col" role="columnheader">{{ t.col_product }}</th><th scope="col" role="columnheader">{{ t.col_sizes }}</th><th scope="col" role="columnheader">{{ t.unit_price }}</th></tr>
  </thead>
  <tbody role="rowgroup">
    {% for item in items %}
    {% assign offer = plugins.shop.products[item.id] %}
    <tr role="row">
      <th scope="row" role="rowheader"><a href="{{ item.path }}">{{ item.title }}</a></th>
      <td role="cell" data-label="{{ t.col_sizes }}">{% if item.frontmatter.sizes != blank %}{% for pair in item.frontmatter.sizes %}{{ pair[1] }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% else %}—{% endif %}</td>
      <td role="cell" data-label="{{ t.unit_price }}">{% if offer %}{% assign state = "avail_" | append: offer.availability %}{% if offer.price_from != blank %}{{ t.price_from }} <span class="price">{{ offer.price_from }}</span><br>{% endif %}<span class="small">{{ t[state] }}</span>{% else %}<span class="small">{{ t.view_specs }}</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
