{%- comment -%}
  Where a content page sits: home, its kind's list when the site has one,
  and for a product its collection (`via`).
{%- endcomment -%}
{%- assign own = site.kinds[content.kind] -%}
<nav class="trail" aria-label="{{ t.breadcrumb }}">
  <ol>
    <li><a href="{{ site.home_path }}">{{ t.home }}</a></li>
    {%- if own %}<li><a href="{{ own.path }}">{{ own.label }}</a></li>{% endif %}
    {%- if via %}<li><a href="{{ via.path }}">{{ via.title }}</a></li>{% endif %}
    <li aria-current="page">{{ content.title }}</li>
  </ol>
</nav>
