{% layout "layouts/base" %}
{% block content %}
<section class="shell">
  <header class="page-head">
    <h1>{{ page.title }}</h1>
    <p class="lede">{{ t.catalogue_lede }}</p>
  </header>
  {% if list.items.size > 0 %}
  {% render "partials/catalogue", items: list.items %}
  {% else %}
  <p>{{ t.empty }}</p>
  {% endif %}
  {% render "partials/pager", list: list %}
</section>
{% if theme.options.cta_title != blank %}{% render "partials/closing" %}{% endif %}
{% endblock %}
