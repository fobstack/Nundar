{% layout "layouts/base" %}
{%- comment -%}
  One order's page, as the shop plugin hands it over (`routes/order.ts`).
  A link that opens no order finds nothing, and says only that.
{%- endcomment -%}
{% block title %}{{ t.order_title }}{% if plugin_page.found %} {{ plugin_page.order_no }}{% endif %} — {{ site.name }}{% endblock %}
{% block content %}
{% assign order = plugin_page %}
<section class="column wide">
  {% if order.found %}
  <h1>{{ t.order_title }} <span class="sku">{{ order.order_no }}</span></h1>
  {% assign status_key = "order_status_" | append: order.status %}
  <dl class="facts">
    <dt>{{ t.order_placed_on }}</dt><dd>{{ order.placed_on }}</dd>
    <dt>{{ t.order_status }}</dt><dd data-status="{{ order.status }}">{{ t[status_key] }}</dd>
    {% if order.carrier != blank %}<dt>{{ t.order_carrier }}</dt><dd>{{ order.carrier }}</dd>{% endif %}
    {% if order.tracking_no != blank %}<dt>{{ t.order_tracking }}</dt><dd><span class="sku">{{ order.tracking_no }}</span></dd>{% endif %}
  </dl>
  {% if order.status == "pending" %}<p class="small">{{ t.order_pending_note }}</p>{% endif %}
  {% if order.status == "paid" and order.lead_time_days %}<p class="small">{{ t.order_ships_within }} {{ order.lead_time_days }} {{ t.business_days }}</p>{% endif %}
  <table class="ledger">
    <tbody>
      {% for line in order.lines %}<tr><th scope="row">{{ line.name }}<br><span class="sku">{{ line.sku }}</span></th><td>× {{ line.quantity }}</td><td><span class="price">{{ line.line_total }}</span></td></tr>{% endfor %}
    </tbody>
  </table>
  <dl class="sums">
    <div><dt>{{ t.subtotal }}</dt><dd><span class="price">{{ order.subtotal }}</span></dd></div>
    <div><dt>{{ t.checkout_shipping }}{% if order.zone != blank %} · {{ order.zone }}{% endif %}</dt><dd><span class="price">{{ order.shipping }}</span></dd></div>
    {% if order.tax != blank %}<div><dt>{{ t.order_tax }}</dt><dd><span class="price">{{ order.tax }}</span></dd></div>{% endif %}
    <div class="total"><dt>{{ t.checkout_total }}</dt><dd><span class="price">{{ order.total }}</span></dd></div>
  </dl>
  {% if order.company != blank or order.address.size > 0 %}
  <h2>{{ t.order_ship_to }}</h2>
  <p>{% if order.company != blank %}{{ order.company }}{% if order.address.size > 0 %}<br>{% endif %}{% endif %}{% for line in order.address %}{{ line }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</p>
  {% if order.tax_id != blank %}<p class="small">{{ t.order_tax_id }}: {{ order.tax_id }}</p>{% endif %}
  {% endif %}
  <p class="small">{{ t.order_questions }}</p>
  {% if order.orders_path != blank %}<p class="small"><a href="{{ order.orders_path }}">{{ t.orders_link }}</a></p>{% endif %}
  {% else %}
  <h1>{{ t.order_title }}</h1>
  <p>{{ t.order_not_found }}</p>
  {% endif %}
</section>
{% endblock %}
