{% layout "layouts/base" %}
{%- comment -%}
  An industry: its picture across the page, then the text, with what
  matters in it — a title block — and the part it is about beside it.
{%- endcomment -%}
{% block content %}
<article>
  <header class="shell page-head">
    {% render "partials/crumbs" %}
    <h1>{{ content.title }}</h1>
    {% if content.description != "" %}<p class="lede">{{ content.description }}</p>{% endif %}
  </header>
  {% if content.cover != blank %}<div class="shell"><figure class="cover"><img src="{{ content.cover }}" alt="" width="1440" height="617" decoding="async"></figure></div>{% endif %}
  {% capture body %}{{ content.html }}{% endcapture %}
  {% assign highlights = content.frontmatter.spec_highlights %}
  {% if body != blank or highlights != blank or content.refs.product %}
  <div class="shell layout">
    {% if body != blank %}<div class="prose">{{ content.html }}</div>{% endif %}
    {% if highlights != blank or content.refs.product %}
    <aside class="beside">
      {% if highlights != blank %}
      <h2>{{ t.spec_highlights }}</h2>
      {% render "partials/titleblock", pairs: highlights %}
      {% endif %}
      {% if content.refs.product %}<a class="part-link" href="{{ content.refs.product.path }}"><span>{{ t.the_part }}</span><strong>{{ content.refs.product.title }}</strong></a>{% endif %}
    </aside>
    {% endif %}
  </div>
  {% endif %}
  {% if content.siblings.size > 0 %}
  <section class="shell section">
    <h2>{{ t.other_applications }}</h2>
    <ul class="cards">{% for item in content.siblings limit: 3 %}{% render "partials/card", item: item %}{% endfor %}</ul>
  </section>
  {% endif %}
</article>
{% endblock %}
