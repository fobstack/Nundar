{% layout "layouts/base" %}
{% block content %}
<article class="shell detail">
  {% render "partials/crumbs", via: content.refs.collection %}

  {% assign shots = content.frontmatter.gallery %}
  {% assign has_gallery = false %}
  {% for path in shots %}{% if content.images[path] %}{% assign has_gallery = true %}{% endif %}{% endfor %}
  <div class="product-top{% unless has_gallery %} product-top-plain{% endunless %}">
    {% if has_gallery %}
    <figure class="gallery" role="group" aria-label="{{ t.gallery }}">
      {%- comment -%}
        The large picture is the first one that exists, which is not always
        the first one named: a path that names no file is skipped, and the
        picture after it must not be loaded as a thumbnail.
      {%- endcomment -%}
      {% assign shown = 0 %}
      {% for path in shots %}
        {% assign shot = content.images[path] %}
        {% if shot %}
        {% assign shown = shown | plus: 1 %}
        <img src="{{ shot.url }}"{% if shot.srcset != "" %} srcset="{{ shot.srcset }}" sizes="{% if shown == 1 %}(max-width: 64rem) 100vw, 44rem{% else %}(max-width: 64rem) 33vw, 15rem{% endif %}"{% endif %}{% if shot.width %} width="{{ shot.width }}" height="{{ shot.height }}"{% endif %} alt="{% if shot.alt != "" %}{{ shot.alt }}{% else %}{{ content.title }} {{ shown }}{% endif %}" loading="{% if shown == 1 %}eager{% else %}lazy{% endif %}" decoding="async">
        {% endif %}
      {% endfor %}
    </figure>
    {% endif %}

    <div class="buy-box">
      {% if content.refs.collection %}<p class="eyebrow">{{ content.refs.collection.title }}</p>{% endif %}
      <h1 class="detail-title">{{ content.title }}</h1>
      {% if content.description != "" %}<p class="detail-lede">{{ content.description }}</p>{% endif %}

      {% assign facets = content.frontmatter.facets %}
      {% if facets != blank %}
      <dl class="facet-list">
        {% for pair in facets %}<div><dt>{{ pair[0] }}</dt><dd>{{ pair[1] }}</dd></div>{% endfor %}
      </dl>
      {% endif %}

      {%- comment -%}
        The sizes on offer, each with the SKU a buyer quotes. The sizes are
        the page's own: written in its front matter, in its language. What
        the shop plugin knows of each — its price, the least that can be
        ordered, whether it can be had and how soon — goes in the row whose
        SKU it carries. A variant the page does not name follows them, under
        the name its options give it, so that nothing that can be bought is
        left off the page. Without the plugin the list is the sizes alone.

        A variant is found by walking the list, not by `variants[sku]`:
        Liquid answers `size`, `first` and `last` on any collection itself,
        whatever a SKU happens to be called.
      {%- endcomment -%}
      {% assign sizes = content.frontmatter.sizes %}
      {% assign shop = plugins.shop %}
      {% if sizes != blank or shop.variants.size > 0 %}
      <section class="size-list">
        <div class="size-head">
          <h2>{{ t.sizes }}</h2>
          {% render "partials/currency" %}
        </div>
        <ul class="offers">
          {% for pair in sizes %}
            {% assign own = nil %}
            {% for variant in shop.variants %}{% if variant.sku == pair[0] %}{% assign own = variant %}{% endif %}{% endfor %}
            {% render "partials/offer", sku: pair[0], size: pair[1], variant: own %}
          {% endfor %}
          {% for variant in shop.variants %}
            {% assign named = false %}
            {% for pair in sizes %}{% if pair[0] == variant.sku %}{% assign named = true %}{% endif %}{% endfor %}
            {% unless named %}{% render "partials/offer", sku: variant.sku, size: variant.label, variant: variant %}{% endunless %}
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      {% assign sheet = content.files[content.frontmatter.datasheet] %}
      {% if theme.options.quote_href != blank or sheet %}
      <div class="buy-actions">
        {% if theme.options.quote_href != blank %}<a class="btn btn-solid" href="{{ theme.options.quote_href }}">{{ t.request_quote }}</a>{% endif %}
        {% if sheet %}<a class="datasheet" href="{{ sheet }}" download>{{ t.datasheet }}</a>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>

  {%- comment -%}
    `content.html` is not a string, so it cannot be compared with one: the
    body is captured first, and a page without one gets no empty box.
  {%- endcomment -%}
  {% capture body %}{{ content.html }}{% endcapture %}
  {% assign specs = content.frontmatter.specs %}
  {% if body != blank or specs != blank %}
  <div class="detail-grid">
    {%- comment -%}
      The body carries the product's features and the uses that have not been
      given a page of their own. Keeping them here is deliberate: they
      strengthen this page for attribute searches, where a page per feature
      would only multiply near-identical pages.
    {%- endcomment -%}
    {% if body != blank %}<div class="detail-main prose">{{ content.html }}</div>{% endif %}

    {% if specs != blank %}
    <aside class="spec-card specs">
      <h2>{{ t.specifications }}</h2>
      <table class="data-table">
        <tbody>
          {% for pair in specs %}<tr><th scope="row">{{ pair[0] }}</th><td>{{ pair[1] }}</td></tr>{% endfor %}
        </tbody>
      </table>
    </aside>
    {% endif %}
  </div>
  {% endif %}

  {%- comment -%}
    The industry pages and case studies written about this product. Each is
    its own landing page; Mallok resolves them from the `product` reference
    they declare, so nothing here has to be kept in step by hand.
  {%- endcomment -%}
  {% if content.backrefs.application.size > 0 %}
  <section class="more">
    <div class="section-head">
      <h2>{{ t.used_in }}</h2>
      <p>{{ t.applications_aside }}</p>
    </div>
    <div class="card-grid">
      {% for item in content.backrefs.application %}{% render "partials/card", item: item, eyebrow: t.application_note %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {% if content.backrefs.case.size > 0 %}
  <section class="more">
    <div class="section-head"><h2>{{ t.cases_with }}</h2></div>
    <div class="card-grid">
      {% for item in content.backrefs.case %}{% render "partials/card", item: item, eyebrow: item.frontmatter.sector %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {% if content.siblings.size > 0 %}
  <section class="more">
    <div class="section-head"><h2>{{ t.related_products }}</h2></div>
    {% render "partials/spec-table", items: content.siblings %}
  </section>
  {% endif %}
</article>
{%- comment -%}
  The currency switch, where there is more than one currency to show.
{%- endcomment -%}
{% if plugins.shop.currencies.size > 1 %}<script src="{{ theme.asset_base }}/currency.js" defer></script>{% endif %}
{% endblock %}
